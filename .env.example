# Template for .env -- copy and fill in. Never commit the filled-in copy.
#   cp .env.example .env
#
# Variables and owners are Contract D in docs/CONTRACTS.md. If you add one here,
# add it there too, or the next person to clone will not know it exists.

# --- LLM provider (Chris) -------------------------------------------------
# Get a free key at https://console.groq.com -> API Keys. Format: gsk_...
# Free tier is rate-limited PER KEY, so all three of us supply one and the
# client rotates on 429. One key alone will throttle during the demo.
GROQ_API_KEY=""
GROQ_API_KEY_2=""
GROQ_API_KEY_3=""

# Verified 2026-09-20 against `uv run python -m app.llm --models`.
# llama-3.3-70b-versatile is NO LONGER SERVED by Groq. Re-check with --models
# before assuming any id still works; the lineup moves.
# Alternatives that also tool-call: openai/gpt-oss-20b (faster), qwen/qwen3.8-27b
GROQ_MODEL="openai/gpt-oss-120b"

# --- MCP (Chris) ----------------------------------------------------------
# stdio for local dev and CI; streamable-http for the deployed service.
MCP_TRANSPORT="stdio"
MCP_SERVER_URL="http://localhost:8765/mcp"

# --- Web app (Eric) -------------------------------------------------------
API_BASE_URL="http://localhost:8000"
LOG_LEVEL="INFO"

# --- RAG (Rob) ------------------------------------------------------------
CHROMA_PATH="./data/chroma"
EMBED_MODEL="BAAI/bge-small-en-v1.5"
RETRIEVAL_K="5"
